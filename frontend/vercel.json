{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "https://api.xcorehub.dev/app/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "https://api.xcorehub.dev/ws/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
