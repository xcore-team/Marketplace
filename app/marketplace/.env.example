# xcore Marketplace — variables d'environnement
# Copier en .env et remplir les valeurs

MARKET_APP_NAME=xcore-market
MARKET_APP_BASE_URL=http://localhost:8000

# Clé secrète HMAC pour la signature des plugins (gate 7)
# python -c "import secrets; print(secrets.token_hex(32))"
MARKET_SECRET_KEY=changeme-generate-a-real-secret

# Limites sandbox par défaut
MARKET_SANDBOX_MEMORY_MB=128
MARKET_SANDBOX_CPU_SECONDS=10
MARKET_SANDBOX_TIMEOUT=30
