# XCore Market — Admin Panel
# Copier en .env.local et adapter selon l'environnement.

# ── API Backend ────────────────────────────────────────────────────────────────
# Développement local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (utiliser .env.production ou variable CI/CD)
# NEXT_PUBLIC_API_URL=https://api.xcorehub.dev

# ── Mock mode ──────────────────────────────────────────────────────────────────
# true  → dashboard sans backend (données simulées, login: n'importe quel email)
# false → connexion backend réelle requise
NEXT_PUBLIC_MOCK_MODE=false

# ── CORS backend ───────────────────────────────────────────────────────────────
# Côté backend (main.py), configurer la variable d'environnement :
#   ALLOWED_ORIGINS=https://admin.xcorehub.dev
# En développement local, la valeur par défaut "*" suffit.
# En production, spécifier le domaine exact du dashboard admin.

# ── Compte admin par défaut (seeder backend) ──────────────────────────────────
# Créé automatiquement au premier démarrage du backend via seed.py :
#   Email    : contact@xcorehub.dev
#   Password : Hunters123@
# À changer impérativement en production via la page profil ou une migration.
