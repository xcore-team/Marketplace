# conf/.env.template — reconstruit en conf/.env par docker-entrypoint.sh au
# démarrage du conteneur. Chaque ligne `KEY=${KEY}` s'auto-résout au
# chargement (python-dotenv, interpolate=True par défaut) contre la VRAIE
# variable d'environnement du même nom déjà présente dans le conteneur —
# c'est Dokploy (ou équivalent) qui doit la fournir, pas ce fichier. Une clé
# non injectée par la plateforme résout simplement en chaîne vide, jamais en
# erreur — voir docker-entrypoint.sh pour le raisonnement complet. Fichier
# git-safe : aucune valeur réelle dedans, uniquement des références.

SECRET_KEY=${SECRET_KEY}
SERVER_KEY=${SERVER_KEY}
DATABASE_URL=${DATABASE_URL}

# Origine API (backend) / frontend web — voir le commentaire dans conf/.env
# de dev pour le raisonnement complet (pourquoi les deux sont distinctes).
APP_BASE_URL=${APP_BASE_URL}
WEB_APP_URL=${WEB_APP_URL}

# Doit être IDENTIQUE à la valeur injectée pour app/xdevkeys/.env.template —
# même clé, même variable d'environnement des deux côtés.
DEVKEYS_MASTER_KEY=${DEVKEYS_MASTER_KEY}

# app/xdeploy — mêmes valeurs que app/xdeploy/.env.template.
XDEPLOY_KEK=${XDEPLOY_KEK}
XDEPLOY_SESSION_SECRET=${XDEPLOY_SESSION_SECRET}

STORAGE_URL_SECRET=${STORAGE_URL_SECRET}

REDIS_URL=${REDIS_URL}
CELERY_BROKER_URL=${CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${CELERY_RESULT_BACKEND}

XAUTH_SMTP_HOST=${XAUTH_SMTP_HOST}
XAUTH_SMTP_PORT=${XAUTH_SMTP_PORT}
XAUTH_SMTP_USER=${XAUTH_SMTP_USER}
XAUTH_SMTP_PASSWORD=${XAUTH_SMTP_PASSWORD}
XAUTH_SMTP_FROM=${XAUTH_SMTP_FROM}
XAUTH_SMTP_FROM_NAME=${XAUTH_SMTP_FROM_NAME}
XAUTH_SMTP_USE_TLS=${XAUTH_SMTP_USE_TLS}

ADMIN_EMAIL=${ADMIN_EMAIL}
MARKETPLACE_TOKEN=${MARKETPLACE_TOKEN}
