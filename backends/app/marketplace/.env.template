# app/marketplace/.env.template — reconstruit en app/marketplace/.env par
# docker-entrypoint.sh au démarrage. envconfiguration.inject: true exige
# que ce fichier existe physiquement (ManifestError sinon) — voir le
# Dockerfile pour le raisonnement complet. DEVKEYS_MASTER_KEY n'est PAS
# listée ici volontairement : marketplace se charge après xdevkeys (voir
# xcore.runtime.loader "loading wave"), donc os.environ l'a déjà reçue via
# conf/.env.template au moment où ce fichier-ci est lu — la déclarer une
# troisième fois serait redondant, pas faux.

APP_NAME=${MARKET_APP_NAME}
APP_BASE_URL=${MARKET_APP_BASE_URL}

# Clé HMAC signant les plugins publiés (gate 7 du pipeline).
MARKET_SECRET_KEY=${MARKET_SECRET_KEY}

# Limites sandbox par défaut (surchargées par plugin.yaml/soumission si
# absentes).
MARKET_SANDBOX_MEMORY_MB=${MARKET_SANDBOX_MEMORY_MB}
MARKET_SANDBOX_CPU_SECONDS=${MARKET_SANDBOX_CPU_SECONDS}
MARKET_SANDBOX_TIMEOUT=${MARKET_SANDBOX_TIMEOUT}
