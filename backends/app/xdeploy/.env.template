# app/xdeploy/.env.template — reconstruit en app/xdeploy/.env par
# docker-entrypoint.sh au démarrage. envconfiguration.inject: true exige
# que ce fichier existe physiquement (ManifestError sinon).

# KEK enveloppant les DEK d'artefacts .xdeploy (AES-256-GCM).
XDEPLOY_KEK=${XDEPLOY_KEK}
# Clé HMAC des jetons de session courts (POST /v1/auth).
XDEPLOY_SESSION_SECRET=${XDEPLOY_SESSION_SECRET}
